# Master Cultivation Reference importer — copy to backend/.env and fill in.
# All values are optional; the importer resolves whatever is present.

# --- Workbook source (one of these) --------------------------------------- #
# A local .xlsx (e.g. the synced "Mushrooms" Drive folder). Highest priority.
# MASTER_SHEET_PATH=/path/to/Master Cultivation Reference.xlsx

# Or pull from Google Drive: an OAuth access token with Drive read scope.
# Defaults to the canonical file id when MASTER_SHEET_FILE_ID is unset.
# GOOGLE_OAUTH_TOKEN=
# MASTER_SHEET_FILE_ID=1KJSAauzZ-CBpA1f4hDISsLzAiFnoh4jC

# --- Targets -------------------------------------------------------------- #
# FastAPI/SQLite DB (defaults to ./shroom.db).
# SHROOM_DB_URL=sqlite:///./shroom.db

# Live Supabase the web app reads (service-role key bypasses RLS — keep secret).
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
