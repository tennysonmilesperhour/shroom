# Master Cultivation Reference sync — copy to backend/.env and fill in.
# All values are optional; sync resolves whatever is present.
#
# The workbook (an Excel .xlsx or a native Google Sheet) is the single source
# of truth, and sync is TWO-WAY:
#   Sheet -> App :  POST /api/sync/pull      (import)
#   App -> Sheet :  POST /api/sync/push      (export), plus a live per-create
#                   mirror when SHEET_SYNC_MIRROR is on.

# --- Read source: where "pull" reads FROM (first match wins) -------------- #
# A local .xlsx (e.g. the synced "Mushrooms" Drive folder). Highest priority.
# MASTER_SHEET_PATH=/path/to/Master Cultivation Reference.xlsx

# Or pull from Google Drive. Preferred: a service-account key JSON (never
# expires) with the workbook shared to the service account's email.
# Provide the JSON as a single-line string.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Alternatively a short-lived OAuth access token:
# GOOGLE_OAUTH_TOKEN=
# An .xlsx binary on Drive (media download). Defaults to the canonical id.
# MASTER_SHEET_FILE_ID=1KJSAauzZ-CBpA1f4hDISsLzAiFnoh4jC

# --- Write target: where "push" / live mirror write TO (first match wins) - #
# A NATIVE Google Sheet — live, cell-level, recommended for true two-way sync.
# Needs Google credentials above with write scope (the code requests
# drive.file + spreadsheets; grant the service account edit access).
# MASTER_SHEET_GOOGLE_ID=1AbC...your_google_sheet_id
# Else an .xlsx on Drive (MASTER_SHEET_FILE_ID, read-modify-reupload), else the
# local MASTER_SHEET_PATH .xlsx above.

# Auto-push: when on, creating/updating a strain/batch/harvest/customer in the
# app pushes the change to the sheet automatically (a non-destructive keyed
# upsert). Pushes are debounced + coalesced so a burst of edits is one write.
# Off by default; with it off, changes mark the app "dirty" and the operator
# pushes manually from the Sheet Sync tab. Push is always non-destructive —
# matching rows update in place; operator-added rows/columns are preserved.
# SHEET_SYNC_AUTO=1
# Seconds to wait after the last change before an auto-push (default 3).
# SHEET_SYNC_DEBOUNCE=3

# --- Other targets -------------------------------------------------------- #
# FastAPI/SQLite DB (defaults to ./shroom.db).
# SHROOM_DB_URL=sqlite:///./shroom.db

# Live Supabase the web app reads (service-role key bypasses RLS — keep secret).
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
