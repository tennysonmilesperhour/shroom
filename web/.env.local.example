# Copy to .env.local for local dev. Set the same vars in Vercel project settings.

# Public (browser-safe) Supabase endpoint + publishable key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Server-only. Required for SSR pages to read past RLS in open-access mode.
# Generate at: Supabase Dashboard → Project Settings → API → service_role key.
# NEVER prefix with NEXT_PUBLIC_ and never expose in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Optional — enables the live AI advisor (server-side only).
# ANTHROPIC_API_KEY=sk-ant-...
# SHROOM_ADVISOR_MODEL=claude-sonnet-4-5

# Optional — enables the "Sync from sheet" button on /sync. It triggers the
# Python importer's GitHub Actions workflow (workflow-dispatch). Create a
# fine-grained PAT with Actions: read & write on this repo.
# GITHUB_DISPATCH_TOKEN=
# GITHUB_REPO=tennysonmilesperhour/shroom
# GITHUB_SYNC_REF=main

# Optional — protects the weekly spore-source crawler cron endpoint
# (/api/cron/spore-crawl). When set, the endpoint requires
# `Authorization: Bearer $CRON_SECRET`; Vercel Cron sends this automatically.
# Leave unset in local dev to allow manual triggering.
# CRON_SECRET=

# Optional: require a shared password for the whole app. Leave unset to keep
# the app open (current behaviour). When set, visitors sign in once at /login
# and stay signed in for 30 days; changing it signs everyone out.
# SHROOM_ACCESS_PASSWORD=

# Optional: live app → sheet write-back. Edits to strains, batches, harvests
# and buyers are written into the matching cells of the Master Cultivation
# Reference right after each save. Needs a *native Google Sheet* (not an
# uploaded .xlsx) shared with the service account's email as an Editor.
# GOOGLE_SERVICE_ACCOUNT_JSON={"client_email":"…","private_key":"…"}
# MASTER_SHEET_GOOGLE_ID=
