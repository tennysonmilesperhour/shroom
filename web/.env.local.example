# Copy to .env.local for local dev. Set the same vars in Vercel project settings.

# Public (browser-safe) Supabase endpoint + publishable key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Server-only. Required for SSR pages to read past RLS in open-access mode.
# Generate at: Supabase Dashboard → Project Settings → API → service_role key.
# NEVER prefix with NEXT_PUBLIC_ and never expose in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Optional — enables the live AI advisor (server-side only).
# ANTHROPIC_API_KEY=sk-ant-...
# SHROOM_ADVISOR_MODEL=claude-sonnet-4-6
