{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/spore-crawl",
      "schedule": "0 6 * * 1"
    }
  ],
  "functions": {
    "api/workbook.py": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules,.next,public,app,components,scripts}/**"
    }
  }
}
